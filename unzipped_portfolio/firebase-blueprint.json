{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "linkedinId": { "type": "string" },
        "instagramId": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "PortfolioConfig": {
      "title": "Portfolio Configuration",
      "description": "Main profile and site-wide configuration",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "about": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "profilePhoto": { "type": "string" },
        "linkedin": { "type": "string" },
        "instagram": { "type": "string" },
        "lastSynced": { "type": "string", "format": "date-time" }
      }
    },
    "Project": {
      "title": "Portfolio Project",
      "description": "Featured work and case studies",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "details": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "order"]
    },
    "SocialMediaPost": {
      "title": "Social Media Post",
      "description": "Recently synced posts from Instagram or LinkedIn",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string", "enum": ["instagram", "linkedin"] },
        "imageUrl": { "type": "string" },
        "caption": { "type": "string" },
        "permalink": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "WorkExperience": {
      "title": "Work Experience",
      "description": "Professional history entry",
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "period": { "type": "string" },
        "type": { "type": "string" },
        "bullets": { "type": "array", "items": { "type": "string" } },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "EducationEntry": {
      "title": "Education Entry",
      "description": "Academic history entry",
      "type": "object",
      "properties": {
        "degree": { "type": "string" },
        "institution": { "type": "string" },
        "period": { "type": "string" },
        "status": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "SkillItem": {
      "title": "Skill Item",
      "description": "Proficiency metrics and labels",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "number" },
        "category": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Certification": {
      "title": "Certification",
      "description": "Professional certificate or award",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "issuer": { "type": "string" },
        "date": { "type": "string" },
        "link": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "ContactMessage": {
      "title": "Contact Message",
      "description": "Form submission from the contact page",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and settings"
    },
    "config/main": {
      "schema": "PortfolioConfig",
      "description": "Global portfolio state"
    },
    "projects/{projectId}": {
      "schema": "Project",
      "description": "Portfolio projects"
    },
    "social_posts/{postId}": {
      "schema": "SocialMediaPost",
      "description": "Synced social media content"
    },
    "experience/{expId}": {
      "schema": "WorkExperience",
      "description": "Professional experience records"
    },
    "education/{eduId}": {
      "schema": "EducationEntry",
      "description": "Academic records"
    },
    "skills/{skillId}": {
      "schema": "SkillItem",
      "description": "Technical and soft skills with metrics"
    },
    "certifications/{certId}": {
      "schema": "Certification",
      "description": "Professional certifications"
    },
    "messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "User contact inquiries"
    }
  }
}
